{
  "name": "alpenpaesse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "bun run scripts/copy-maplibre-worker.ts && next dev",
    "build": "bun run scripts/copy-maplibre-worker.ts && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "bun test lib",
    "e2e": "NEXT_PUBLIC_TEST_HOOKS=1 bun run build && bun test e2e",
    "typecheck": "tsc --noEmit",
    "data:build": "bun run scripts/build-data.ts",
    "data:check": "bun run scripts/check-data.ts",
    "ui:init": "bunx shadcn@latest init --preset b1D2ui9g",
    "ui:add": "bunx shadcn@latest add badge button card collapsible dialog drawer empty field input input-group label native-select popover radio-group separator skeleton slider switch table toggle toggle-group tooltip"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.42.0",
    "maplibre-gl": "^6.7.0",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@^7.0.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.3.0",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.3.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
