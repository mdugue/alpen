{
  "name": "alpenpaesse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "bun run scripts/copy-maplibre-worker.ts && bun run scripts/build-map-assets.ts && bun run scripts/build-detail-assets.ts && bun run scripts/build-map-style.ts && next dev",
    "build": "bun run scripts/copy-maplibre-worker.ts && bun run scripts/build-map-assets.ts && bun run scripts/build-detail-assets.ts && bun run scripts/build-map-style.ts && next build",
    "start": "next start",
    "lint": "ultracite check && bun run seams && bun run palette",
    "lint:fix": "ultracite fix",
    "test": "bun test lib scripts components",
    "e2e": "NEXT_PUBLIC_TEST_HOOKS=1 bun run build && bun run e2e:run",
    "e2e:run": "bun test --timeout 20000 e2e",
    "typecheck": "next typegen && tsc --noEmit",
    "data:build": "bun run scripts/build-data.ts",
    "data:check": "bun run scripts/check-data.ts",
    "data:photos": "bun run scripts/build-photos.ts",
    "data:locate": "bun run scripts/locate-pass.ts",
    "data:backfill": "bash scripts/backfill.sh",
    "data:schema": "bun run scripts/emit-json-schema.ts",
    "docs:diagrams": "bun run scripts/render-diagrams.ts",
    "analyze:status": "bun run scripts/analyze-status.ts",
    "analyze:destinations": "bun run scripts/analyze-destinations.ts",
    "palette": "bun run scripts/check-palette.ts",
    "seams": "bun run scripts/check-seams.ts",
    "map:glyphs": "bun run scripts/build-glyphs.ts",
    "ui:init": "bunx shadcn@latest init --preset b1D2ui9g",
    "ui:add": "bunx shadcn@latest add badge button button-group carousel chart collapsible dialog drawer dropdown-menu empty field input input-group item label popover radio-group separator skeleton switch table toggle tooltip"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@shikijs/rehype": "^4.4.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "embla-carousel-react": "^8.6.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "hast-util-to-string": "^3.0.1",
    "lucide-react": "^1.47.0",
    "maplibre-gl": "^6.11.1",
    "next": "^16.3.6",
    "nuqs": "^2.10.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "3.10.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shadcn": "^4.21.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "mermaid": "^12.0.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-plugin-react-doctor": "^0.9.14",
    "oxlint-tsgolint": "7.0.2002",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.3.0",
    "typescript": "^7.0.2",
    "ultracite": "^7.12.0"
  }
}
