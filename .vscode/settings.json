{
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "emmet.showExpandedAbbreviation": "never",
  "[css]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[html]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[markdown]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[scss]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[yaml]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },
  "json.schemas": [
    {
      "fileMatch": ["/data/passes.json"],
      "url": "./data/schema/passes.schema.json"
    },
    {
      "fileMatch": ["/data/tours.json"],
      "url": "./data/schema/tours.schema.json"
    },
    {
      "fileMatch": ["/data/towns.json"],
      "url": "./data/schema/towns.schema.json"
    },
    {
      "fileMatch": ["/data/i18n/en/passes.json"],
      "url": "./data/schema/passes.en.schema.json"
    },
    {
      "fileMatch": ["/data/i18n/en/tours.json"],
      "url": "./data/schema/tours.en.schema.json"
    },
    {
      "fileMatch": ["/data/i18n/en/towns.json"],
      "url": "./data/schema/towns.en.schema.json"
    },
    {
      "fileMatch": ["/data/i18n/en/destinations.json"],
      "url": "./data/schema/destinations.en.schema.json"
    },
    {
      "fileMatch": ["/data/generated/routes.json"],
      "url": "./data/schema/routes.schema.json"
    },
    {
      "fileMatch": ["/data/generated/profiles.json"],
      "url": "./data/schema/profiles.schema.json"
    },
    {
      "fileMatch": ["/data/generated/climate.json"],
      "url": "./data/schema/climate.schema.json"
    },
    {
      "fileMatch": ["/data/generated/routes-meta.json"],
      "url": "./data/schema/routes-meta.schema.json"
    },
    {
      "fileMatch": ["/data/generated/rejected.json"],
      "url": "./data/schema/rejected.schema.json"
    },
    {
      "fileMatch": ["/data/generated/summits.json"],
      "url": "./data/schema/summits.schema.json"
    }
  ]
}
