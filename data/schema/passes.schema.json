{
  "$id": "passes.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "slug": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "name": {
        "type": "string",
        "minLength": 2
      },
      "aliases": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 2
        }
      },
      "country": {
        "type": "string",
        "pattern": "^[A-Z]{2}(?:\\/[A-Z]{2})?$"
      },
      "region": {
        "type": "string",
        "enum": [
          "Westalpen",
          "Zentralalpen",
          "Ostalpen",
          "Dolomiten"
        ]
      },
      "lat": {
        "type": "number",
        "minimum": 43,
        "maximum": 49
      },
      "lon": {
        "type": "number",
        "minimum": 4,
        "maximum": 16
      },
      "elevation": {
        "type": "integer",
        "minimum": 300,
        "maximum": 3500
      },
      "classicAscent": {
        "type": "string"
      },
      "beauty": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5
      },
      "fame": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5
      },
      "difficulty": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5
      },
      "traffic": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5
      },
      "season": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "opens": {
                "type": "number"
              },
              "closes": {
                "type": "number"
              },
              "maintained": {
                "type": "boolean"
              }
            },
            "required": [
              "opens",
              "closes"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "note": {
        "type": "string"
      },
      "ascents": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "from": {
              "type": "object",
              "properties": {
                "lat": {
                  "type": "number",
                  "minimum": 43,
                  "maximum": 49
                },
                "lon": {
                  "type": "number",
                  "minimum": 4,
                  "maximum": 16
                }
              },
              "required": [
                "lat",
                "lon"
              ],
              "additionalProperties": false
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "check": {
              "type": "object",
              "properties": {
                "maxKm": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "maxStartDist": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "maxEndDist": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "maxTopDelta": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "minPeakAt": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "maxGain": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "note": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "note"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "from",
            "label"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "slug",
      "name",
      "country",
      "region",
      "lat",
      "lon",
      "elevation",
      "classicAscent",
      "beauty",
      "fame",
      "difficulty",
      "traffic",
      "season",
      "note",
      "ascents"
    ],
    "additionalProperties": false
  }
}
