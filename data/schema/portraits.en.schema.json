{
  "$id": "portraits.en.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "propertyNames": {
    "type": "string",
    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
  },
  "additionalProperties": {
    "type": "object",
    "properties": {
      "intro": {
        "type": "string",
        "minLength": 1
      },
      "sides": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "character": {
              "type": "string",
              "minLength": 1
            },
            "highlights": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  }
}
