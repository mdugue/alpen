{
  "$id": "summits.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "propertyNames": {
    "type": "string",
    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
  },
  "additionalProperties": {
    "type": "object",
    "properties": {
      "dem": {
        "type": "number"
      },
      "lat": {
        "type": "number"
      },
      "lon": {
        "type": "number"
      },
      "roadDist": {
        "type": [
          "number",
          "null"
        ]
      }
    },
    "required": [
      "dem",
      "lat",
      "lon"
    ],
    "additionalProperties": false
  }
}
