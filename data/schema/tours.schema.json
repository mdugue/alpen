{
  "$id": "tours.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "check": {
        "type": "object",
        "properties": {
          "maxKmDelta": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "maxWaypointDist": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "note"
        ],
        "additionalProperties": false
      },
      "color": {
        "type": "string",
        "pattern": "^#[0-9a-f]{6}$"
      },
      "description": {
        "type": "string"
      },
      "elevationGain": {
        "type": "number",
        "minimum": 0
      },
      "km": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "name": {
        "type": "string",
        "minLength": 2
      },
      "note": {
        "type": "string"
      },
      "passes": {
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "router": {
        "type": "object",
        "properties": {
          "note": {
            "type": "string",
            "minLength": 1
          },
          "use": {
            "type": "string",
            "enum": [
              "osrm",
              "cycling-regular"
            ]
          }
        },
        "required": [
          "note",
          "use"
        ],
        "additionalProperties": false
      },
      "season": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "closes": {
                "type": "number"
              },
              "opens": {
                "type": "number"
              }
            },
            "required": [
              "closes",
              "opens"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "series": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "slug": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "surface": {
        "type": "string",
        "enum": [
          "asphalt",
          "gravel",
          "mixed"
        ]
      },
      "touches": {
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "type": {
        "type": "string",
        "enum": [
          "loop",
          "event",
          "edition",
          "permanent",
          "stages"
        ]
      },
      "waypoints": {
        "minItems": 2,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "lat": {
              "type": "number",
              "minimum": 27.5,
              "maximum": 52.1
            },
            "lon": {
              "type": "number",
              "minimum": -18.3,
              "maximum": 20.5
            }
          },
          "required": [
            "lat",
            "lon"
          ],
          "additionalProperties": false
        }
      },
      "when": {
        "type": "number"
      },
      "year": {
        "type": "integer",
        "minimum": 2000,
        "maximum": 2100
      }
    },
    "required": [
      "color",
      "description",
      "elevationGain",
      "km",
      "name",
      "note",
      "passes",
      "season",
      "slug",
      "surface",
      "type",
      "waypoints"
    ],
    "additionalProperties": false
  }
}
