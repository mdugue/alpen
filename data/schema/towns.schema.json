{
  "$id": "towns.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "aliases": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 2
        }
      },
      "country": {
        "type": "string",
        "enum": [
          "FR",
          "IT",
          "CH",
          "AT",
          "DE",
          "SI",
          "ES",
          "AD",
          "LI",
          "CZ",
          "BE",
          "PL",
          "SK"
        ]
      },
      "lat": {
        "type": "number",
        "minimum": 27.5,
        "maximum": 52.1
      },
      "lon": {
        "type": "number",
        "minimum": -18.3,
        "maximum": 20.5
      },
      "name": {
        "type": "string",
        "minLength": 2
      },
      "slug": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "tags": {
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "hub",
            "passes",
            "workshops",
            "hotels",
            "scenic",
            "quiet",
            "train",
            "events",
            "season"
          ]
        }
      },
      "why": {
        "type": "string"
      }
    },
    "required": [
      "country",
      "lat",
      "lon",
      "name",
      "slug",
      "tags",
      "why"
    ],
    "additionalProperties": false
  }
}
