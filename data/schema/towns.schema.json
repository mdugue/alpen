{
  "$id": "towns.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "slug": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "name": {
        "type": "string",
        "minLength": 2
      },
      "country": {
        "type": "string",
        "enum": [
          "FR",
          "IT",
          "CH",
          "AT",
          "DE",
          "SI"
        ]
      },
      "lat": {
        "type": "number",
        "minimum": 43,
        "maximum": 49
      },
      "lon": {
        "type": "number",
        "minimum": 4,
        "maximum": 16
      },
      "why": {
        "type": "string"
      }
    },
    "required": [
      "slug",
      "name",
      "country",
      "lat",
      "lon",
      "why"
    ],
    "additionalProperties": false
  }
}
