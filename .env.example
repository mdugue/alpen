# Routing for scripts/build-data.ts (road-cycling profile instead of the OSRM car profile)
# https://openrouteservice.org/dev  – free, 2000 routes/day
ORS_KEY=

# Absolute base URL for canonical links, share images, robots.txt and sitemap.xml.
# On Vercel it is derived from VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL;
# set it only for a custom domain or another host.
NEXT_PUBLIC_SITE_URL=

# Optional map tiles (used client-side only, hence NEXT_PUBLIC_)
NEXT_PUBLIC_THUNDERFOREST_KEY=
NEXT_PUBLIC_MAPTILER_KEY=
